# ==============================================================================
# Person 1 AI Internship Suite (ApexAI Suite) - Environment Configuration
# Copy this file to .env and insert your real credentials when running live mode.
# If no keys are provided, the entire suite automatically uses deterministic mock mode.
# ==============================================================================

# LLM Providers (Optional for live execution)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Active LLM Provider: 'gemini' | 'openai' | 'mock'
DEFAULT_LLM_PROVIDER=mock

# Task 1: JSON Extractor Server
TASK1_PORT=8001

# Task 2: Document RAG Server
TASK2_PORT=8002
TASK2_CHUNK_SIZE=600
TASK2_CHUNK_OVERLAP=120
TASK2_SIMILARITY_THRESHOLD=0.35

# Task 3: Tool Agent Guardrails
TASK3_MAX_ITERATIONS=6
TASK3_TIMEOUT_SECONDS=30
TASK3_SAFE_WORKSPACE=./safe_workspace

# Task 4: Streamlit Chatbot
STREAMLIT_PORT=8501
STREAMLIT_THEME=dark
